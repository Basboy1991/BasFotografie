# Production site origin. Never include a trailing slash.
SITE_URL=https://bas-fotografie.vercel.app
# Connect Neon Postgres to the project. Use a separate preview database.
DATABASE_URL=
# Connect a PRIVATE Vercel Blob store. BLOB_STORE_ID enables OIDC on Vercel.
BLOB_STORE_ID=
# Optional for local development/client uploads when supplied by Vercel.
BLOB_READ_WRITE_TOKEN=
# Generate a password hash with npm run auth:password. Never put the password here.
ADMIN_PASSWORD_HASH=
# A separate random secret of at least 32 characters, for encrypted sessions.
SESSION_SECRET=
