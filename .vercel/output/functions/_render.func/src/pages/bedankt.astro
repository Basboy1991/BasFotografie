---
import Layout from "@/components/Layout.astro";
import { getSiteSettings } from "@/data/site";

const site = await getSiteSettings();
---

<Layout
  title="Bedankt voor je aanvraag"
  description="Je aanvraag is ontvangen door Bas Fotografie."
  currentPath="/bedankt/"
>
  <section class="page-hero compact">
    <p class="eyebrow">Aanvraag ontvangen</p>
    <h1>Bedankt voor je aanvraag</h1>
    <p>
      Bas neemt persoonlijk contact met je op. Wil je nog iets toevoegen, stuur dan gerust een bericht via WhatsApp of e-mail.
    </p>
    <div class="hero-actions">
      <a class="button" href={site.whatsappHref}>WhatsApp Bas</a>
      <a class="button button-secondary" href="/">Terug naar home</a>
    </div>
  </section>
</Layout>
