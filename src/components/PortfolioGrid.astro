---
import { getPortfolioItems } from "@/data/site";

interface Props {
  limit?: number;
  interactive?: boolean;
  showcase?: boolean;
  selectedCategory?: string;
}

const { limit, interactive = false, showcase = false, selectedCategory } = Astro.props;
const portfolioItems = await getPortfolioItems();
const items = typeof limit === "number" ? portfolioItems.slice(0, limit) : portfolioItems;
const categories = ["Kinderen", "Gezinnen", "Huisdieren", "Portretten"];
const albums = [...categories, "Privearchief"];
const categoryDescriptions: Record<string, string> = {
  Kinderen: "Spontane blikken, beweging en kleine momenten buiten.",
  Gezinnen: "Verbinding in beeld, rustig en zonder opgelegde poses.",
  Huisdieren: "Karakter, energie en aandacht voor de details die je herkent.",
  Portretten: "Persoonlijke portretten met ruimte voor licht, rust en eigenheid.",
  Privearchief: "Een vrije verzameling van bijzondere beelden die gezien mogen worden.",
};
const groupedAlbums = albums.map((category) => ({
  category,
  items: portfolioItems.filter((item) => item.category === category),
}));
const filteredItems = selectedCategory && albums.includes(selectedCategory)
  ? items.filter((item) => item.category === selectedCategory)
  : [];
const showAlbums = showcase || (interactive && !selectedCategory);
---

{interactive && (
  <nav class="filter-bar" aria-label="Portfolioalbums">
    <a class="filter-button" href="/portfolio/" aria-current={!selectedCategory ? "page" : undefined}>Alle albums</a>
    {albums.map((album) => (
      <a
        class="filter-button"
        href={`/portfolio/?category=${encodeURIComponent(album)}#portfolio-detail`}
        aria-current={selectedCategory === album ? "page" : undefined}
      >
        {album === "Privearchief" ? "Privéarchief" : album}
      </a>
    ))}
  </nav>
)}

{showAlbums && (
  <div class="portfolio-showcase portfolio-album-shelf" aria-label="Portfolioalbums">
    {groupedAlbums.map(({ category, items: categoryItems }, categoryIndex) => (
      <a
        class={`portfolio-showcase-card portfolio-showcase-card-${categoryIndex + 1}`}
        href={`/portfolio/?category=${encodeURIComponent(category)}#portfolio-detail`}
        aria-label={`Open album ${category === "Privearchief" ? "privéarchief" : category}`}
      >
        <span class="portfolio-showcase-media" data-crossfade>
          {categoryItems.map((item, imageIndex) => (
            <img
              class={imageIndex === 0 ? "is-active" : undefined}
              src={item.image}
              alt={imageIndex === 0 ? item.alt : ""}
              aria-hidden={imageIndex === 0 ? undefined : "true"}
              loading={categoryIndex < 2 && imageIndex === 0 ? "eager" : "lazy"}
            />
          ))}
        </span>
        <span class="portfolio-showcase-copy">
          <span class="eyebrow">Album 0{categoryIndex + 1}</span>
          <strong>{category === "Privearchief" ? "Privéarchief" : category}</strong>
          <small>{categoryDescriptions[category]}</small>
          <span class="text-link">Album openen <span aria-hidden="true">↗</span></span>
        </span>
      </a>
    ))}
  </div>
)}

{interactive && selectedCategory && (
  <>
    <div class="portfolio-album-grid" id="portfolio-detail" data-lightbox-gallery>
      {filteredItems.map((item, index) => (
        <article class={`portfolio-album-card portfolio-album-card-${(index % 6) + 1}`}>
          <button
            class="portfolio-album-photo"
            type="button"
            data-lightbox-open
            data-image={item.image}
            data-alt={item.alt}
            data-category={item.category}
            data-title={item.title}
            data-description={item.description}
            data-note={item.note}
            style={`--photo-image: url('${item.image}')`}
            aria-label={`Bekijk ${item.title} groot`}
          >
            <img src={item.image} alt={item.alt} loading={index < 3 ? "eager" : "lazy"} />
            <span class="portfolio-hover-copy" aria-hidden="true">
              <span class="portfolio-hover-cutout">{item.category}</span>
              <span class="portfolio-hover-title">{item.title}</span>
            </span>
          </button>
          <p><strong>{item.title}</strong><span>{item.category}</span></p>
        </article>
      ))}
    </div>

    <dialog class="portfolio-lightbox" data-lightbox aria-label="Vergrote portfoliofoto">
      <button class="portfolio-lightbox-close" type="button" data-lightbox-close aria-label="Sluiten">×</button>
      <div class="portfolio-lightbox-layout">
        <figure><img data-lightbox-image src="" alt="" /></figure>
        <div class="portfolio-lightbox-copy">
          <p class="eyebrow" data-lightbox-category></p>
          <h2 data-lightbox-title></h2>
          <p data-lightbox-description></p>
          <p class="portfolio-detail-note" data-lightbox-note></p>
          <a class="button button-secondary" href="/contact/">Plan een soortgelijke shoot</a>
        </div>
      </div>
    </dialog>
  </>
)}

{showAlbums && (
  <script>
    document.querySelectorAll<HTMLElement>("[data-crossfade]").forEach((card) => {
      const images = Array.from(card.querySelectorAll<HTMLImageElement>("img"));
      if (images.length < 2) return;
      let activeIndex = 0;
      window.setInterval(() => {
        images[activeIndex].classList.remove("is-active");
        activeIndex = (activeIndex + 1) % images.length;
        images[activeIndex].classList.add("is-active");
      }, 4600);
    });
  </script>
)}

{interactive && selectedCategory && (
  <script>
    const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
    const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const category = dialog?.querySelector<HTMLElement>("[data-lightbox-category]");
    const title = dialog?.querySelector<HTMLElement>("[data-lightbox-title]");
    const description = dialog?.querySelector<HTMLElement>("[data-lightbox-description]");
    const note = dialog?.querySelector<HTMLElement>("[data-lightbox-note]");

    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-open]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!dialog || !image || !category || !title || !description || !note) return;
        image.src = button.dataset.image ?? "";
        image.alt = button.dataset.alt ?? "";
        category.textContent = button.dataset.category ?? "";
        title.textContent = button.dataset.title ?? "";
        description.textContent = button.dataset.description ?? "";
        note.textContent = button.dataset.note ?? "";
        dialog.showModal();
      });
    });

    dialog?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
)}
