---
import { getSiteSettings } from "@/data/site";

interface Props {
  title?: string;
  body?: string;
}

const {
  title = "Heb je iets in gedachten?",
  body = "Vertel me wie je wilt laten fotograferen en welke plek goed voelt. Je krijgt gewoon antwoord van mij.",
} = Astro.props;
const site = await getSiteSettings();
---

<section class="cta-band" aria-labelledby="cta-title">
  <div>
    <p class="eyebrow">Rechtstreeks naar Bas</p>
    <h2 id="cta-title">{title}</h2>
    <p>{body}</p>
  </div>
  <div class="cta-actions">
    <a class="button" href="/contact/">Stuur me je idee</a>
    <a class="text-link text-link-light" href={site.whatsappHref}>App me <span aria-hidden="true">↗</span></a>
  </div>
</section>
