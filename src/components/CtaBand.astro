---
import { getSiteSettings } from "@/data/site";

interface Props {
  title?: string;
  body?: string;
}

const {
  title = "Klaar om een shoot te plannen?",
  body = "Vertel kort wie je wilt laten fotograferen en welke plek je in gedachten hebt. Bas reageert persoonlijk.",
} = Astro.props;
const site = await getSiteSettings();
---

<section class="cta-band" aria-labelledby="cta-title">
  <div>
    <p class="eyebrow">Aanvraag</p>
    <h2 id="cta-title">{title}</h2>
    <p>{body}</p>
  </div>
  <div class="cta-actions">
    <a class="button" href="/contact/">Aanvraag doen</a>
    <a class="button button-quiet" href={site.whatsappHref}>WhatsApp Bas</a>
  </div>
</section>
