---
import Layout from "@/components/Layout.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import PackageCards from "@/components/PackageCards.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getProcessSteps, getSiteSettings } from "@/data/site";

const site = await getSiteSettings();
const processSteps = await getProcessSteps();
---

<Layout
  title="Fotograaf Naaldwijk en Westland"
  description="Bas Fotografie maakt pure portretten van kinderen, gezinnen en huisdieren op locatie in Naaldwijk en gemeente Westland."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{site.heroEyebrow}</p>
      <h1>
        <span>Geen stijve poses.</span>
        <em>Wel een foto die klopt.</em>
      </h1>
      <p class="hero-lead">
        {site.heroBody} Je hoeft niets te kunnen voor mijn camera; ik help waar dat nodig is.
      </p>
      <div class="hero-actions">
        <a class="button" href="/portfolio/">Bekijk mijn werk</a>
        <a class="text-link" href="/contact/">Stuur me je idee <span aria-hidden="true">↗</span></a>
      </div>
      <p class="availability"><span aria-hidden="true"></span> Op locatie in Naaldwijk en de rest van het Westland</p>
    </div>

    <figure class="hero-frame">
      <div class="focus-frame">
        <img src="/assets/portfolio/kinderen-01.webp" alt="Beeldmarkering voor een toekomstige foto uit het portfolio van Bas" />
      </div>
      <figcaption>
        <span>kinderen · gezinnen · huisdieren · portretten</span>
        <span>Naaldwijk / Westland</span>
      </figcaption>
    </figure>
  </section>

  <section class="split-section">
    <SectionIntro
      eyebrow="Zo fotografeer ik"
      title="Je hoeft niets te kunnen voor mijn camera."
      body="Een shoot mag richting hebben, maar hoeft geen toneelstuk te worden. Ik kijk, wacht en stuur alleen bij wanneer dat helpt."
    />
    <div class="feature-list">
      <article>
        <p class="feature-label">De plek</p>
        <h3>Waar jullie al op je gemak zijn</h3>
        <p>Thuis, in het park, aan het strand of ergens anders in het Westland.</p>
      </article>
      <article>
        <p class="feature-label">Tijdens de shoot</p>
        <h3>Richting als het helpt</h3>
        <p>Geen harde poses. Wel rustige aanwijzingen en ruimte om te bewegen.</p>
      </article>
      <article>
        <p class="feature-label">Na afloop</p>
        <h3>Alleen de beelden die kloppen</h3>
        <p>Je ontvangt een zorgvuldige selectie bewerkte foto's in een online galerij.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <SectionIntro
      eyebrow="Mijn werk"
      title="Niet het poseren. Juist wat er tussendoor gebeurt."
      body="Kinderen, gezinnen, dieren en portretten — buiten of op een plek die vertrouwd voelt."
    />
    <PortfolioGrid limit={8} />
    <div class="center-action">
      <a class="text-link" href="/portfolio/">Bekijk het hele portfolio <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section section-muted">
    <SectionIntro
      eyebrow="Tijd & tarieven"
      title="Kies hoeveel ruimte bij jullie past."
      body="Een half uur voor een korte serie, of meer tijd om rustig verschillende momenten te maken."
    />
    <PackageCards />
  </section>

  <section class="section">
    <SectionIntro
      eyebrow="Van bericht tot beeld"
      title="Helder geregeld, zonder boekingsstraat."
      body="Je hebt steeds rechtstreeks contact met mij. Zo weten we allebei wat we kunnen verwachten."
    />
    <div class="process-grid">
      {
        processSteps.map((step, index) => (
          <article>
            <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Layout>
