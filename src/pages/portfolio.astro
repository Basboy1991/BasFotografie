---
import Layout from "@/components/Layout.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import CtaBand from "@/components/CtaBand.astro";
---

<Layout
  title="Portfolio"
  description="Portfolio van Bas Fotografie: kinderfotografie, gezinsfotografie, huisdierfotografie en portretten in Naaldwijk en Westland."
  currentPath="/portfolio/"
>
  <section class="page-hero compact">
    <p class="eyebrow">Portfolio</p>
    <h1>Mijn blik op mensen en dieren</h1>
    <p>
      Geen vaste poses of ingestudeerde glimlach. Ik zoek naar de blik, beweging en kleine gebaren die al van jullie zijn.
    </p>
  </section>

  <section class="section">
    <SectionIntro
      title="Waar wil je naar kijken?"
      body="Kies een categorie of bekijk alles door elkaar."
    />
    <PortfolioGrid interactive />
  </section>

  <CtaBand title="Past deze manier van kijken bij jullie?" body="Vertel me wat je wilt bewaren zoals het nu is." />
</Layout>
