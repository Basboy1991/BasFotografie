---
import Layout from "@/components/Layout.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import CtaBand from "@/components/CtaBand.astro";

const requestedCategory = Astro.url.searchParams.get("category") ?? undefined;
const selectedCategory = ["Kinderen", "Gezinnen", "Huisdieren", "Portretten", "Privearchief"].includes(requestedCategory ?? "")
  ? requestedCategory
  : undefined;
---

<Layout
  title="Portfolio"
  description="Portfolio van Bas Fotografie: kinderfotografie, gezinsfotografie, huisdierfotografie en portretten in Naaldwijk en Westland."
  currentPath="/portfolio/"
>
  <section class="page-hero compact">
    <p class="eyebrow">Portfolio</p>
    <h1>{selectedCategory ? `Portfolio ${selectedCategory.toLowerCase()}` : "Selectietafel voor kinderen, gezinnen, huisdieren en portretten"}</h1>
    <p>
      {selectedCategory
        ? "Een rustige serie met beelden die naast elkaar hun eigen verhaal vertellen."
        : "Open een album, blader door de losse afdrukken en bekijk iedere foto groot met het verhaal ernaast."}
    </p>
  </section>

  <section class="section">
    <SectionIntro
      title={selectedCategory ? `Album ${selectedCategory === "Privearchief" ? "privéarchief" : selectedCategory.toLowerCase()}` : "Kies een album"}
      body={selectedCategory ? "Klik op een foto om deze groot te bekijken." : "Ieder album heeft een eigen ritme, crossfade en verhaal."}
    />
    <PortfolioGrid interactive selectedCategory={selectedCategory} />
  </section>

  <CtaBand title="Wil je zelf op deze selectietafel komen?" body="Vraag een shoot aan en vertel wat je wilt vastleggen." />
</Layout>
