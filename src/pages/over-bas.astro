---
import Layout from "@/components/Layout.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getSiteSettings } from "@/data/site";

const site = await getSiteSettings();
const hasProfilePhoto = site.profileImage !== "/assets/portfolio/portretten-01.webp";
---

<Layout
  title="Over Bas"
  description="Maak kennis met Bas van der Scheer, fotograaf achter Bas Fotografie in Naaldwijk en gemeente Westland."
  currentPath="/over-bas/"
>
  <section class="about-hero">
    <div>
      <p class="eyebrow">Over Bas</p>
      <h1>Ik kijk liever dan dat ik laat poseren.</h1>
      <p>{site.profileIntro}</p>
    </div>
    <figure>
      {
        hasProfilePhoto ? (
          <img src={site.profileImage} alt={`Portret van ${site.person}`} />
        ) : (
          <div class="bas-portrait-card" aria-label="Bas van der Scheer, fotograaf in het Westland">
            <span>bas.</span>
            <small>achter de camera<br />in het Westland</small>
          </div>
        )
      }
      <figcaption>{hasProfilePhoto ? site.profileImageCaption : `${site.person} · Naaldwijk`}</figcaption>
    </figure>
  </section>

  <section class="split-section">
    <SectionIntro
      eyebrow="Mijn manier van werken"
      title="Ik geef richting en wacht daarna op wat er gebeurt."
      body={site.profileBody}
    />
    <div class="feature-list">
      <article>
        <p class="feature-label">Vertrouwen</p>
        <h3>Jullie bepalen wat online komt</h3>
        <p>Beelden van kinderen en gezinnen publiceer ik alleen wanneer ze expliciet zijn goedgekeurd.</p>
      </article>
      <article>
        <p class="feature-label">Dichtbij</p>
        <h3>Thuis in het Westland</h3>
        <p>Ik fotografeer in Naaldwijk en op plekken in de buurt waar jullie je prettig voelen.</p>
      </article>
      <article>
        <p class="feature-label">Contact</p>
        <h3>Je spreekt altijd met mij</h3>
        <p>Geen anonieme boekingsstraat; je hebt rechtstreeks contact via formulier, mail of WhatsApp.</p>
      </article>
    </div>
  </section>

  <CtaBand title="Zullen we kennismaken?" body="Stuur me je idee, ook als je nog twijfelt over pakket, locatie of timing." />
</Layout>
