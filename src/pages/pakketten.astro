---
import Layout from "@/components/Layout.astro";
import PackageCards from "@/components/PackageCards.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import CtaBand from "@/components/CtaBand.astro";
---

<Layout
  title="Pakketten en prijzen"
  description="Pakketten en prijzen voor kinderfotografie, gezinsfotografie, huisdierfotografie en portretten door Bas Fotografie in Westland."
  currentPath="/pakketten/"
>
  <section class="page-hero compact">
    <p class="eyebrow">Pakketten</p>
    <h1>Genoeg tijd voor een foto die klopt</h1>
    <p>
      Drie heldere keuzes voor een shoot op locatie. Je kiest vooral hoeveel rust en variatie je wilt.
    </p>
  </section>

  <section class="section">
    <PackageCards />
    <p class="fineprint">
      De genoemde bedragen zijn totaalprijzen voor een shoot in het Westland. Daarbuiten stemmen we de reistijd vooraf af.
    </p>
  </section>

  <section class="split-section">
    <SectionIntro
      eyebrow="Mijn advies"
      title="Kies op tijd, niet alleen op het aantal foto's."
      body="Bij kinderen en dieren is extra tijd vaak geen luxe, maar de ruimte waarin de mooiste blik vanzelf ontstaat."
    />
    <div class="feature-list">
      <article>
        <h3>Kort</h3>
        <p>Fijn voor een korte portretupdate of een enkel moment.</p>
      </article>
      <article>
        <h3>Ruim</h3>
        <p>De beste balans voor de meeste gezinnen, kinderen en huisdieren.</p>
      </article>
      <article>
        <h3>Serie</h3>
        <p>Meer rust voor meerdere combinaties, locaties of een grotere serie.</p>
      </article>
    </div>
  </section>

  <CtaBand title="Weet je nog niet wat past?" body="Vertel me wat je voor je ziet. Dan denk ik mee over de tijd die daarvoor nodig is." />
</Layout>
