---
import Layout from "@/components/Layout.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getFaqs } from "@/data/site";

const faqs = await getFaqs();
---

<Layout
  title="Veelgestelde vragen"
  description="Veelgestelde vragen over fotoshoots, pakketten, locaties, levering en prijzen bij Bas Fotografie."
  currentPath="/faq/"
>
  <section class="page-hero compact">
    <p class="eyebrow">FAQ</p>
    <h1>Veelgestelde vragen</h1>
    <p>
      Antwoorden op de praktische vragen rond een fotoshoot in Naaldwijk en gemeente Westland.
    </p>
  </section>

  <section class="section">
    <div class="faq-list">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaBand title="Staat je vraag er niet tussen?" body="Stuur Bas gerust een bericht. Dan stemmen jullie het gewoon persoonlijk af." />
</Layout>
