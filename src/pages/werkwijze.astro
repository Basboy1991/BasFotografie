---
import Layout from "@/components/Layout.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getProcessSteps } from "@/data/site";

const processSteps = await getProcessSteps();
---

<Layout
  title="Werkwijze"
  description="Zo werkt een fotoshoot bij Bas Fotografie: aanvragen, afstemmen, fotograferen en opleveren via een online galerij."
  currentPath="/werkwijze/"
>
  <section class="page-hero compact">
    <p class="eyebrow">Werkwijze</p>
    <h1>Ik houd het graag rustig en duidelijk</h1>
    <p>
      Een fotoshoot hoeft niet ingewikkeld te voelen. Vanaf je eerste bericht heb je rechtstreeks contact met mij.
    </p>
  </section>

  <section class="section">
    <div class="timeline">
      {
        processSteps.map((step, index) => (
          <article>
            <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
            <h2>{step.title}</h2>
            <p>{step.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="split-section section-muted">
    <SectionIntro
      eyebrow="De plek"
      title="Ergens waar jullie niet eerst hoeven te wennen."
      body="Denk aan een park, strand, tuin, huiselijke setting of een andere plek in het Westland waar jullie ontspannen zijn."
    />
    <div class="photo-strip" aria-label="Beeldrichtingen voor fotoshoots op locatie">
      <img src="/assets/portfolio/gezinnen-01.webp" alt="Abstracte beeldmarkering voor een gezin op locatie" loading="lazy" />
      <img src="/assets/portfolio/kinderen-02.webp" alt="Abstracte beeldmarkering voor een kind op locatie" loading="lazy" />
      <img src="/assets/portfolio/huisdieren-02.webp" alt="Abstracte beeldmarkering voor een huisdier op locatie" loading="lazy" />
    </div>
  </section>

  <CtaBand />
</Layout>
